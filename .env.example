# Password untuk masuk ke dashboard (WAJIB diganti sebelum deploy production)
APP_PASSWORD=dashboard123

# Secret untuk menandatangani token sesi (WAJIB diganti dengan string acak panjang)
APP_SECRET=ganti-dengan-string-acak-panjang

# --- Opsional: hanya diisi kalau deploy ke Vercel dengan Upstash Redis ---
# Kalau kosong, data GL disimpan di file lokal (data/gl-data.json) — cukup untuk development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Opsional: hanya diisi kalau deploy ke Vercel dengan Vercel Blob ---
# Kalau kosong, file GL asli disimpan di file lokal (data/uploads/).
BLOB_READ_WRITE_TOKEN=
